&ACCESS RVP
&REL 2
DEF ROBOTSYNC()
  BAS(#INITMOV,0)
  PTP $AXIS_ACT

  INTERRUPT DECL 5 WHEN $IN[1] DO OnProbeTriggered()
  INTERRUPT DECL 6 WHEN $IN[1] DO StopMovementInterrupt()
  INTERRUPT ON 6

  $ORI_TYPE = #VAR
  $CIRC_TYPE = #BASE
  $VEL.ORI1 = 200
  $VEL.ORI2 = 200
  $ACC.ORI1 = 100
  $ACC.ORI2 = 100

  $VEL.CP = 3
  $ACC.CP = 3

  $BASE = {FRAME: X 0, Y 0, Z 0, A 0, B 0, C 0}
  $TOOL = {FRAME: X 0, Y 0, Z 0, A 0, B 0, C 0}

  $ADVANCE = 0
  $APO.CPTP = 0
  $APO.CDIS = 0

  COM_ROUNDM = -1
  COM_ACTCNT = 0
  $FLAG[1] = FALSE

  WHILE TRUE
    ActionLoop()
  ENDWHILE
END

DEF ActionLoop()
  DECL INT io_id
  COM_ACTION = 0
  WHILE COM_ACTION >= 0
    SWITCH COM_ACTION
    CASE 3
      LIN COM_E6POS
      COM_ACTION = 0
    CASE 10
      COM_ACTCNT = COM_ACTCNT + 1
      io_id = COM_VALUE1
      IF COM_VALUE2 > 0.5 THEN
        $OUT[io_id] = TRUE
      ELSE
        $OUT[io_id] = FALSE
      ENDIF
      COM_ACTION = 0
    ENDSWITCH
  ENDWHILE
END

DEF OnProbeTriggered()
  INTERRUPT OFF 5
  COM_VALUE1 = 1
  BRAKE
  RESUME
END

DEF StopMovementInterrupt()
  INTERRUPT OFF 6
  $IN[1] = FALSE
  BRAKE F
END